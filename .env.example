# Server
PORT=3000
SERVER_URL=https://your-app.railway.app

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Encryption key for stored refresh tokens (use any random string, 32+ chars)
ENCRYPTION_KEY=generate-a-random-string-at-least-32-characters

# Password to access the /setup page
ADMIN_PASSWORD=pick-a-strong-password

# Bearer token required on the /mcp endpoint (strongly recommended).
# Without it, anyone who knows the URL can read every connected mailbox.
# MCP_API_KEY=generate-another-random-string

# WorkOS AuthKit domain for OAuth on /mcp (for the claude.ai web connector,
# which cannot send a static bearer). Requires Dynamic Client Registration
# enabled in the WorkOS dashboard. Works alongside MCP_API_KEY — either
# credential is accepted.
# WORKOS_AUTHKIT_DOMAIN=https://your-tenant.authkit.app

# Data directory for token storage (default: ./data)
# DATA_DIR=./data

# Request the full https://mail.google.com/ scope instead of gmail.modify.
# Only needed for PERMANENT deletion (delete_email / batch_delete). Accounts
# must be re-added via /setup after changing this (re-consent).
# GMAIL_FULL_ACCESS=true
